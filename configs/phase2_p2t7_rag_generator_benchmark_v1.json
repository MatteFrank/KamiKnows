{
  "config_version": "phase2_p2t7_rag_generator_benchmark_v1",
  "project": "KnowKami / M-Fond LLM",
  "task": "Phase 2 Task 07 - RAG Generator and Configuration Benchmark v1",
  "input": {
    "rag_ready_dir": "outputs/rag_ready_fastcalo_v1",
